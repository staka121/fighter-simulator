{
  "name": "fighter-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@types/leaflet": "^1.9.22",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.4"
  }
}
